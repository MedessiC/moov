# EmailJS Configuration
# Get these from https://www.emailjs.com/

# Your EmailJS Service ID
VITE_EMAILJS_SERVICE_ID=service_g6qpvd7

# Your EmailJS Template ID
VITE_EMAILJS_TEMPLATE_ID=template_mideessi_work

# Your EmailJS Public Key (IMPORTANT: Keep this SECRET in production!)
# Add this to your .env file locally, but DO NOT commit it
# In production, set this via environment variables on your hosting platform
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Note: Without VITE_EMAILJS_PUBLIC_KEY, the site will run in demo mode
# where form submissions are simulated (not sent via email)
